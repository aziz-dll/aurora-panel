# Force LF for shell scripts and Node — Termux bash can't handle CRLF
# (Windows editors often save with CRLF and break the shebang line).
*.sh        text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.gradle    text eol=lf
*.java      text eol=lf
*.kt        text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
