<?xml version="1.0" encoding="utf-8"?>
<!-- Today widget satırı: check dairesi (ring + fill iki katman, RemoteViews'ta
     görünürlük ile değiştirilir) + alışkanlık adı + streak. Tüm satır tıklanabilir. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habit_today_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <FrameLayout
        android:id="@+id/widget_habit_today_check"
        android:layout_width="20dp"
        android:layout_height="20dp">

        <View
            android:id="@+id/widget_habit_today_check_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_habit_today_ring" />

        <View
            android:id="@+id/widget_habit_today_check_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_habit_today_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:textSize="14sp"
        android:textColor="@color/widget_text"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_habit_today_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textSize="11sp"
        android:textColor="@color/widget_sub" />
</LinearLayout>
