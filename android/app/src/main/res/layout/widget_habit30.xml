<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habit30_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <View
            android:id="@+id/widget_habit30_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/widget_habit30_dot" />

        <TextView
            android:id="@+id/widget_habit30_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="HABIT 30"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/widget_title"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_habit30_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#F59E0B"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_habit30_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text"
        android:singleLine="true"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/widget_habit30_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_habit30_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textColor="@color/widget_sub"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_habit30_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/widget_sub"
            android:singleLine="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_habit30_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:gravity="center"
        android:padding="14dp"
        android:text="No active habit yet — open Aurora"
        android:textColor="@color/widget_sub"
        android:textSize="12sp" />
</LinearLayout>
